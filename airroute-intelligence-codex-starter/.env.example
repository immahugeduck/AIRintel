# Frontend-safe configuration
# Only variables prefixed with VITE_ are bundled into the browser.
# Never place ADS-B, OpenSky client secrets, Supabase service-role keys,
# or OpenAI keys in VITE_ variables.

VITE_APP_NAME=AirRoute Intelligence

# MapQuest public/client configuration, if your selected MapQuest integration
# permits browser use of this key. Confirm the current MapQuest plan and terms.
VITE_MAPQUEST_KEY=
VITE_MAPQUEST_TILE_URL=

# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values
SUPABASE_SERVICE_ROLE_KEY=

ADSB_PROVIDER=
ADSB_API_BASE_URL=
ADSB_API_KEY=

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

OPENAI_API_KEY=

# Ingestion and analysis
AIRCRAFT_POLL_INTERVAL_SECONDS=20
DEFAULT_CENTER_LAT=
DEFAULT_CENTER_LON=
DEFAULT_RADIUS_NM=20
