# ---------------------------------------------------------------------------
# Browser-safe values only (exposed to the client bundle by Vite).
# Never place a secret in a VITE_ variable.
# Mapbox browser maps use a PUBLIC access token beginning with pk.
# ---------------------------------------------------------------------------
VITE_APP_NAME=AIRIntel
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=mapbox/streets-v12
# Neon Auth base URL: Neon Console -> your project -> Auth -> Configuration (ends in /auth).
# After `neon deploy` it is also written to .env as NEON_AUTH_BASE_URL - use the same value here.
VITE_NEON_AUTH_URL=
# URLs of the AIRIntel API. On Vercel these default to same-origin /api/* when left empty.
# Override only when the API is hosted on a different origin (Neon Function / Cloud Run / local :8787).
VITE_AIRCRAFT_API_URL=/api/aircraft-nearby
VITE_HISTORY_API_URL=/api/history
VITE_PROFILE_API_URL=/api/aircraft-profile
VITE_DEFAULT_CENTER_LAT=39.7684
VITE_DEFAULT_CENTER_LON=-86.1581
VITE_DEFAULT_RADIUS_NM=20
VITE_POLL_INTERVAL_SECONDS=20

# ---------------------------------------------------------------------------
# Server-only (API in server/, migrations, admin scripts). Never prefix with VITE_.
# On a deployed Neon Function, DATABASE_URL, NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL are
# injected automatically. Locally, `neon link` / `neon env pull` writes them to .env.local,
# or copy them from Neon Console -> Connect.
# ---------------------------------------------------------------------------
# Pooled Postgres connection string (used by the API at runtime).
DATABASE_URL=
# Direct (non-pooled) connection string (used by `npm run db:migrate` and the access:* scripts).
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Optional; derived from NEON_AUTH_BASE_URL (/.well-known/jwks.json) when empty.
NEON_AUTH_JWKS_URL=
# Comma-separated browser origins allowed to call the API (CORS + origin guard).
ALLOWED_ORIGINS=http://localhost:5173
# Port for `npm run api:dev` (local Node server).
API_PORT=8787

# Live aircraft provider (see docs/provider-onboarding.md).
# Default when unset: adsb_lol (public readsb feed, no key). Set to "off" to disable.
ADSB_PROVIDER=adsb_lol
# Optional override; defaults to https://api.adsb.lol for adsb_lol.
ADSB_API_BASE_URL=
# Required only for keyed/commercial providers — not needed for adsb_lol.
ADSB_API_KEY=
# OpenSky OAuth client (not wired yet; reserved for a future corroborating source).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Vercel Blob evidence storage
# Must match the access mode chosen when the Blob store was created: private or public.
BLOB_ACCESS=private
# New Vercel-connected Blob stores use OIDC automatically in deployed Functions.
# For local development only, `vercel env pull` may provide the required Blob credentials.
# Never expose Blob write credentials through a VITE_ variable.
BLOB_READ_WRITE_TOKEN=
