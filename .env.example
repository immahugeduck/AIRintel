# ---------------------------------------------------------------------------
# Browser-safe values only (exposed to the client bundle by Vite).
# Never place a secret in a VITE_ variable.
# Mapbox browser maps use a PUBLIC access token beginning with pk.
# ---------------------------------------------------------------------------
VITE_APP_NAME=AIRIntel
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_STYLE=mapbox/streets-v12
# Neon Auth base URL: Neon Console -> your project -> Auth -> Configuration (ends in /auth).
# After `neon deploy` it is also written to .env as NEON_AUTH_BASE_URL - use the same value here.
VITE_NEON_AUTH_URL=
# URLs of the deployed AIRIntel API (Neon Function `api`, or http://localhost:8787 for `npm run api:dev`).
VITE_AIRCRAFT_API_URL=
VITE_HISTORY_API_URL=
VITE_PROFILE_API_URL=
VITE_DEFAULT_CENTER_LAT=39.7684
VITE_DEFAULT_CENTER_LON=-86.1581
VITE_DEFAULT_RADIUS_NM=20
VITE_POLL_INTERVAL_SECONDS=20

# ---------------------------------------------------------------------------
# Server-only (API in server/, migrations, admin scripts). Never prefix with VITE_.
# On a deployed Neon Function, DATABASE_URL, NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL are
# injected automatically. Locally, `neon link` / `neon env pull` writes them to .env.local,
# or copy them from Neon Console -> Connect.
# ---------------------------------------------------------------------------
# Pooled Postgres connection string (used by the API at runtime).
DATABASE_URL=
# Direct (non-pooled) connection string (used by `npm run db:migrate` and the access:* scripts).
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Optional; derived from NEON_AUTH_BASE_URL (/.well-known/jwks.json) when empty.
NEON_AUTH_JWKS_URL=
# Comma-separated browser origins allowed to call the API (CORS + origin guard).
ALLOWED_ORIGINS=http://localhost:5173
# Port for `npm run api:dev` (local Node server).
API_PORT=8787

# Live aircraft provider (gated by docs/provider-onboarding.md)
ADSB_PROVIDER=
ADSB_API_BASE_URL=
ADSB_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
