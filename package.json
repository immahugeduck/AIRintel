{
  "name": "airintel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "faa:validate": "node scripts/faa-validate.mjs",
    "api:dev": "tsx watch server/node.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "access:grant": "node scripts/access.mjs grant",
    "access:revoke": "node scripts/access.mjs revoke",
    "access:list": "node scripts/access.mjs list"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@tanstack/react-query": "^5.83.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "satellite.js": "7.0.1",
    "zod": "^4.0.15",
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
