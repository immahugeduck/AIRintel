# Stage 1: Build the React application
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the app using Nginx
FROM nginx:alpine
# Copy built static files from Stage 1 to Nginx's html folder
COPY --from=builder /app/dist /usr/share/nginx/html

# (Note: If your React build folder is named 'build' instead of 'dist', change '/app/dist' to '/app/build')

# Cloud Run requires applications to listen on the port defined by the PORT environment variable
# We configure Nginx to listen on port 8080 dynamically
EXPOSE 8080
RUN sed -i 's/listen       80;/listen       8080;/g' /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]
